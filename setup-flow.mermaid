flowchart TD
    A[./setup.sh] --> B{Xcode CLT installed?}
    B -->|no| B1[xcode-select --install → re-run]
    B -->|yes| C{Homebrew installed?}
    C -->|no| C1[install Homebrew]
    C1 --> D
    C -->|yes| D[brew bundle --file=Brewfile]

    D --> E[git config + git-delta]
    E --> F[nvm → Node LTS + corepack]
    F --> G[uv → Python]
    G --> H[Claude Code native installer]
    H --> I[append ~/.zshrc managed block]
    I --> J[~/Projects + optional SSH key]

    J --> K{Mobile block in Brewfile?}
    K -->|Xcode present| K1[accept license + first launch]
    K -->|Xcode missing| K2[print App Store install link]
    K1 --> L[flutter doctor + android-licenses]
    K2 --> L
    K -->|web only| M

    L --> M[Done → next steps]

    %% Apps come from the Brewfile (edit to choose); this script wires up
    %% Homebrew, languages, shell, and the mobile toolchain.

    classDef startEnd fill:#e1f5fe,stroke:#01579b,stroke-width:2px
    classDef decision fill:#fff3e0,stroke:#e65100,stroke-width:2px
    classDef process fill:#f3e5f5,stroke:#4a148c,stroke-width:2px

    class A,M startEnd
    class B,C,K decision
    class D,E,F,G,H,I,J,L process
